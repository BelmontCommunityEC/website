---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { forms, socials } from '../../config';
import { advocacyMetrics } from '../../data/advocacy-metrics';

const protectATreeAssists = advocacyMetrics.campaignAssists['protect-a-tree'] ?? 0;
const policyUrl = 'https://www.belmont.wa.gov.au/docs/ecm/local-planning-policy-no-21-tree-development-exemption-and-assessment-policy.pdf';
---

<BaseLayout
  title="Protect Our Tree Canopy"
  description="Draft an email to the City of Belmont about a private tree at risk of removal or damage under Local Planning Policy No. 21."
  image="/site_assets/BCEC Logo (1200 x 630 px).png"
>
  <section class="bg-brand-light/50">
    <div class="mx-auto max-w-3xl px-4 py-6">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <a href="/advocacy" class="inline-flex min-h-11 items-center text-sm font-semibold text-brand-dark hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">
          ← Advocacy
        </a>
        <p class="inline-flex rounded-full bg-brand-dark px-3 py-1 text-xs font-semibold uppercase tracking-wide text-white">
          Take action
        </p>
      </div>
      <h1 class="mt-4 font-heading text-3xl font-bold text-brand-dark sm:text-4xl">
        Protect Our Tree Canopy
      </h1>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-ink sm:text-lg">
        Under the City of Belmont’s Local Planning Policy No.21, many trees on private properties are protected, helping the retention of healthy, established trees and securing much-needed canopy in our area. 

      </p>
        <p class="mt-3 max-w-3xl text-base leading-relaxed text-ink sm:text-lg">
          But to help the City identify when a protected tree may be at risk of removal or damage, we need to act, and as early as possible. 
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-3xl px-4 pt-6 pb-10 sm:pt-8 sm:pb-12">
    <section aria-labelledby="how-heading">
      <h2 id="how-heading" class="font-heading text-xl font-bold text-brand-dark">How?</h2>
      <p class="mt-2 max-w-3xl text-base leading-relaxed text-ink">
        You can help by:
      </p>
      <ul class="mt-3 max-w-3xl space-y-3">
        {[
          'Noticing properties with large trees in your neighbourhood',
          'Watching for recent property sales, with demolition or significant renovation likely',
          'Observing chainsaw or large heavy machinery being used on large trees',
        ].map((tip) => (
          <li class="flex items-start gap-3">
            <svg
              class="mt-0.5 h-5 w-5 flex-shrink-0 text-brand"
              viewBox="0 0 20 20"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M16.704 5.29a1 1 0 010 1.42l-7.5 7.5a1 1 0 01-1.42 0l-3.5-3.5a1 1 0 111.42-1.42l2.79 2.79 6.79-6.79a1 1 0 011.42 0z"
                clip-rule="evenodd"
              />
            </svg>
            <span class="min-w-0 text-base leading-relaxed text-ink">{tip}</span>
          </li>
        ))}
      </ul>
    </section>
      <section class="mt-8 border-l-4 border-brand bg-brand-light/40 p-4 sm:mt-10 sm:p-6" aria-labelledby="speak-up-heading">
        <h2 id="speak-up-heading" class="font-heading text-xl font-bold text-brand-dark">
          Say something (and straight away!)
        </h2>
        <p class="mt-2 max-w-3xl text-base leading-relaxed text-ink">
          If removal or damaging work is underway or appears imminent:
          call the City of Belmont right now on{' '}
          <a href="tel:0894777222" class="font-semibold text-brand-dark underline underline-offset-2 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">(08) 9477 7222</a>{' '}
          and ask for the Planning Compliance team. We recommend then following up with an email (see below).
        </p>
      </section>
      <section class="prose mt-6 max-w-none prose-headings:font-heading prose-headings:text-brand-dark prose-p:text-ink prose-li:text-ink prose-a:text-brand" aria-labelledby="put-in-writing-heading">
        <h2 id="put-in-writing-heading" class="mt-0 mb-2 text-xl font-bold">Put it in writing</h2>
        <p class="mt-0 mb-0">
          If it’s not time critical, send the City an email (we’ve helped with a draft email template below).
        </p>
        <p class="mt-3 mb-0">Tips:</p>
        <ul class="mt-3 mb-0 grid gap-3">
          <li class="mt-0 mb-0">Answer what you can and leave anything you’re unsure about blank.</li>
          <li class="mt-0 mb-0">When your draft is ready, review it, open it in your email app, add any photos, and press ‘send’.</li>
        </ul>
        <p class="not-prose mt-3 mb-0 text-sm italic leading-relaxed text-muted">
          Your answers stay in your browser and aren’t saved by this website. BCEC only receives
          them if you choose to copy us into the email and send it. 
        </p>
      </section>

    <details class="mt-6 border-y border-brand-light py-2" aria-labelledby="protected-trees-heading">
      <summary id="protected-trees-heading" class="min-h-11 cursor-pointer py-2 font-heading text-lg font-semibold text-brand-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">
        Which trees are protected?
      </summary>
      <div class="prose max-w-none prose-p:text-ink prose-a:text-brand">
        <p class="mt-3 mb-3">
          Local Planning Policy No. 21 starts from a presumption that trees will be retained.
          Unless an exemption applies, removing or damaging trees on private land requires development approval.
        </p>
        <p class="mt-3 mb-0">
          Exemptions apply to small trees, palm trees, pencil pines and listed weed species.
          Unsure if a tree is protected or exempt? Our email template will guide you through the
          criteria, or{' '}
          <a href={policyUrl} target="_blank" rel="noopener noreferrer" class="underline-offset-2 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">read the policy in full (PDF, opens in a new tab)</a>.
        </p>
      </div>
    </details>

    <section class="mt-8 sm:mt-10" aria-labelledby="email-builder-heading">
      <h2 id="email-builder-heading" class="font-heading text-2xl font-bold text-brand-dark">
        Draft your email
      </h2>

      <form id="tree-concern-form" class="mt-6 space-y-8 sm:space-y-10">
        
        <fieldset class="min-w-0">
          <legend class="font-heading text-lg font-bold text-brand-dark">
            Tree size and type
          </legend>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            Select each option that appears to apply.
          </p>
          <div class="mt-4 grid gap-3">
            {[
              {
                name: 'height',
                question: 'The tree is approximately 8 metres or more in height.',
                help: 'Taller than a two-storey house.',
              },
              {
                name: 'canopy',
                question: 'The tree’s average canopy is approximately 6 metres or more in width.',
                help: 'The leafy section is wider than a two-car garage.',
              },
              {
                name: 'trunk',
                question: 'The trunk circumference is approximately 1.5 metres or more, measured 1.4 metres above ground.',
                help: 'An average adult\'s fingers wouldn\'t touch if they tried to hug the tree (at chest height).',
              },
            ].map((measurement) => (
              <label class="flex min-h-11 cursor-pointer gap-3 rounded-lg border border-gray-200 p-4 hover:border-brand-light">
                <input type="checkbox" name="measurement" value={measurement.name} class="mt-1 h-5 w-5 flex-none accent-brand" />
                <span>
                  <span class="block text-base font-semibold leading-relaxed text-ink">{measurement.question}</span>
                  {measurement.help && <span class="mt-2 block text-sm leading-relaxed text-muted">{measurement.help}</span>}
                </span>
              </label>
            ))}
          </div>
          <label class="mt-3 flex min-h-11 cursor-pointer gap-3 rounded-lg border border-gray-200 p-4 hover:border-brand-light">
            <input
            id="exempt-tree-type"
            type="checkbox"
            name="exemptTreeType"
            aria-describedby="exempt-tree-help"
            aria-controls="exempt-tree-guidance"
            class="mt-1 h-5 w-5 flex-none accent-brand"
            />
            <span>
              <span class="block text-base font-semibold leading-relaxed text-ink">
                The tree is a palm, pencil pine or a species listed on a State or local weed register.
              </span>
              <span id="exempt-tree-help" class="mt-2 block text-sm leading-relaxed text-muted">
                Only select this if you’re confident. If you’re unsure, leave it unchecked.
              </span>
            </span>
          </label>
          <div aria-live="polite" aria-atomic="true">
            <div id="exempt-tree-guidance" hidden class="mt-4 rounded-xl border border-brand-light bg-brand-light/30 p-4 sm:p-6">
              <h3 class="font-heading text-lg font-bold text-brand-dark">Thanks for looking out for our local trees.</h3>
              <p id="exempt-tree-type-guidance" class="mt-2 text-sm leading-relaxed text-muted">
                Under the policy, palms, pencil pines and listed weed species are generally
                exempt from needing approval for removal or damage, regardless of their size. 
                For these trees, this email template isn’t the right next step, so we’ve paused it here while this option is selected. If you’re unsure or
                selected it by mistake, uncheck it to continue. Your answers will still be here.
                A Tree Preservation Order may still provide protection. If you think this could be an option, contact the City for advice.
              </p>
              <p id="tree-size-guidance" hidden class="mt-2 text-sm leading-relaxed text-muted">
                You haven’t selected a tree size option. Trees smaller than all three size thresholds are
                generally exempt from needing approval for removal or damage. If a measurement option above does appear to apply for this tree, please select it before continuing.
                
              </p>
              <p id="template-continuation-guidance" class="mt-3 text-sm leading-relaxed text-muted">
                If you’re still unsure about the tree’s size, you can still continue with the template.
              </p>
              <p class="mt-3 text-sm leading-relaxed text-muted">
                Check the size and species exemptions in clauses 5.1.1(a)–(b) of{' '}
                <a href={policyUrl} target="_blank" rel="noopener noreferrer" class="font-semibold text-brand-dark underline underline-offset-2 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">
                  the City’s Local Planning Policy No. 21 (PDF, opens in a new tab)
                </a>.
              </p>
            </div>
          </div>
        </fieldset>
        <fieldset class="min-w-0">
          <legend class="font-heading text-lg font-bold text-brand-dark">Tree address</legend>
          <label for="tree-address" class="mt-4 block text-sm font-semibold text-ink">
            What is the address of the property?
          </label>
          <input
            id="tree-address"
            name="address"
            type="text"
            autocomplete="street-address"
            placeholder="e.g. 10 Example St, Kewdale"
            class="mt-2 min-h-11 w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-ink focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20"
          />
        </fieldset>

        <fieldset class="min-w-0" data-email-workflow>
          <legend class="font-heading text-lg font-bold text-brand-dark">
            Why do you believe the tree may be at risk?
          </legend>
          <div class="mt-4 grid gap-3 sm:grid-cols-2">
            <label class="flex cursor-pointer gap-3 rounded-lg border border-gray-200 p-4 text-sm leading-relaxed hover:border-brand-light">
              <input type="checkbox" name="riskReason" value="removal or damaging work is happening now" data-suggest-urgent class="mt-1 h-5 w-5 flex-none accent-brand" />
              <span>Removal or damaging work is happening now.</span>
            </label>
            <label class="flex cursor-pointer gap-3 rounded-lg border border-gray-200 p-4 text-sm leading-relaxed hover:border-brand-light">
              <input type="checkbox" name="riskReason" value="clearing, excavation or other work has begun near the tree" data-suggest-urgent class="mt-1 h-5 w-5 flex-none accent-brand" />
              <span>Clearing, excavation or other work has begun near the tree.</span>
            </label>
            <label class="flex cursor-pointer gap-3 rounded-lg border border-gray-200 p-4 text-sm leading-relaxed hover:border-brand-light">
              <input type="checkbox" name="riskReason" value="contractors, machinery or tree-removal equipment have been observed" data-suggest-urgent class="mt-1 h-5 w-5 flex-none accent-brand" />
              <span>Contractors, machinery or tree-removal equipment have been observed.</span>
            </label>
            <label class="flex cursor-pointer gap-3 rounded-lg border border-gray-200 p-4 text-sm leading-relaxed hover:border-brand-light">
              <input type="checkbox" name="riskReason" value="the tree appears to have been marked for removal" data-suggest-urgent class="mt-1 h-5 w-5 flex-none accent-brand" />
              <span>The tree appears to have been marked for removal.</span>
            </label>
            <p id="urgent-suggestion" class="rounded-lg border-l-4 border-brand bg-brand-light/40 p-4 text-sm leading-relaxed text-ink sm:col-span-2" hidden aria-live="polite">
              Your answers suggest this concern may be urgent. If removal or damaging work is underway or appears imminent, call the City right now on{' '}
              <a href="tel:0894777222" class="font-semibold text-brand-dark underline underline-offset-2 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">(08) 9477 7222</a>{' '}
              and ask for the Planning Compliance team. Then follow up with the email drafted below.
            </p>
            <label class="flex cursor-pointer gap-3 rounded-lg border border-gray-200 p-4 text-sm leading-relaxed hover:border-brand-light">
              <input type="checkbox" name="riskReason" value="the tree appears to have been ringbarked or poisoned" class="mt-1 h-5 w-5 flex-none accent-brand" />
              <span>The tree appears to have been ringbarked or poisoned.</span>
            </label>
            <label class="flex cursor-pointer gap-3 rounded-lg border border-gray-200 p-4 text-sm leading-relaxed hover:border-brand-light">
              <input type="checkbox" name="riskReason" value="the tree has otherwise been damaged" class="mt-1 h-5 w-5 flex-none accent-brand" />
              <span>The tree has otherwise been damaged.</span>
            </label>
            <label class="flex cursor-pointer gap-3 rounded-lg border border-gray-200 p-4 text-sm leading-relaxed hover:border-brand-light">
              <input type="checkbox" name="riskReason" value="the tree has been heavily pruned, lopped or topped" class="mt-1 h-5 w-5 flex-none accent-brand" />
              <span>The tree has been heavily pruned, lopped or topped.</span>
            </label>
            <label class="flex cursor-pointer gap-3 rounded-lg border border-gray-200 p-4 text-sm leading-relaxed hover:border-brand-light">
              <input type="checkbox" name="riskReason" value="I have been told that the tree may be removed" class="mt-1 h-5 w-5 flex-none accent-brand" />
              <span>I have been told that the tree may be removed.</span>
            </label>
            <label class="flex cursor-pointer gap-3 rounded-lg border border-gray-200 p-4 text-sm leading-relaxed hover:border-brand-light">
              <input type="checkbox" name="riskReason" value="building, demolition or renovation work appears to be planned" class="mt-1 h-5 w-5 flex-none accent-brand" />
              <span>Building, demolition or renovation work appears to be planned.</span>
            </label>
            <label class="flex cursor-pointer gap-3 rounded-lg border border-gray-200 p-4 text-sm leading-relaxed hover:border-brand-light">
              <input type="checkbox" name="riskReason" value="the property was recently sold or listed for sale" class="mt-1 h-5 w-5 flex-none accent-brand" />
              <span>The property was recently sold or listed for sale.</span>
            </label>
            <label class="flex cursor-pointer gap-3 rounded-lg border border-gray-200 p-4 text-sm leading-relaxed hover:border-brand-light">
              <input type="checkbox" name="riskReason" value="the tree has already been removed" class="mt-1 h-5 w-5 flex-none accent-brand" />
              <span>The tree has already been removed.</span>
            </label>
          </div>
          <label for="risk-other" class="mt-4 block text-sm font-semibold text-ink">
            Describe what you observed or add other details
          </label>
          <textarea id="risk-other" name="riskOther" rows="3" class="mt-2 w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-ink focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20"></textarea>
          <label class="mt-4 flex cursor-pointer gap-3 rounded-lg border border-brand-light bg-brand-light/30 p-4">
            <input type="checkbox" name="urgent" class="mt-1 h-5 w-5 flex-none accent-brand" />
            <span>
              <strong class="block text-brand-dark">The concern is urgent</strong>
              <span class="mt-1 block text-sm text-muted">Add “URGENT” to the subject and copy planning@belmont.wa.gov.au into the email.</span>
            </span>
          </label>
        </fieldset>

        <fieldset class="min-w-0" data-email-workflow>
          <legend class="font-heading text-lg font-bold text-brand-dark">Photos and your details</legend>
          <label class="mt-4 flex cursor-pointer gap-3 rounded-lg border border-gray-200 p-4 text-sm leading-relaxed hover:border-brand-light">
            <input type="checkbox" name="hasPhotos" class="mt-1 h-5 w-5 flex-none accent-brand" />
            <span>I have photos to attach.</span>
          </label>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            You will need to attach the photos yourself after opening the email draft.
            Take photos only from a public place or somewhere you have permission to be.
          </p>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            <label class="block text-sm font-semibold text-ink">
              Photo date
              <input name="photoDate" type="date" class="mt-2 min-h-11 w-full rounded-lg border border-gray-300 bg-white px-3 py-2 font-normal text-ink focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20" />
            </label>
            <label class="block text-sm font-semibold text-ink">
              Photo time
              <input name="photoTime" type="time" class="mt-2 min-h-11 w-full rounded-lg border border-gray-300 bg-white px-3 py-2 font-normal text-ink focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20" />
            </label>
            <label class="block text-sm font-semibold text-ink">
              Your name
              <input name="senderName" type="text" autocomplete="name" class="mt-2 min-h-11 w-full rounded-lg border border-gray-300 bg-white px-3 py-2 font-normal text-ink focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20" />
            </label>
            <label class="block text-sm font-semibold text-ink">
              Your email (optional)
              <input name="senderEmail" type="email" autocomplete="email" class="mt-2 min-h-11 w-full rounded-lg border border-gray-300 bg-white px-3 py-2 font-normal text-ink focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20" />
            </label>
            <label class="block text-sm font-semibold text-ink">
              Your phone number (optional)
              <input name="senderPhone" type="tel" autocomplete="tel" class="mt-2 min-h-11 w-full rounded-lg border border-gray-300 bg-white px-3 py-2 font-normal text-ink focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20" />
            </label>
          </div>
          {socials.email && (
            <label class="mt-4 flex cursor-pointer gap-3 rounded-lg border border-gray-200 p-4 text-sm leading-relaxed hover:border-brand-light">
              <input type="checkbox" name="copyBcec" value={socials.email} class="mt-1 h-5 w-5 flex-none accent-brand" />
              <span>
                <strong class="block text-brand-dark">Copy BCEC into the email</strong>
                <span class="mt-1 block text-muted">Add {socials.email} to the CC field so BCEC knows you raised the concern.</span>
              </span>
            </label>
          )}
        </fieldset>
      </form>
    </section>

    <section class="mt-8 rounded-xl border border-brand-light bg-surface p-4 sm:mt-10 sm:p-6" aria-labelledby="preview-heading" data-email-workflow>
      <div class="border-b border-brand-light pb-4">
        <h2 id="preview-heading" class="font-heading text-2xl font-bold text-brand-dark">
          Review your email
        </h2>
        <div class="mt-2 space-y-3 text-sm leading-relaxed text-muted">
          <p>
            You can now open the drafted email in your email app using the button below, then attach
            your photos and send it.
          </p>
          <p>
            If your email app does not open, you can use the drafted text and copy
            buttons below to paste the draft directly into a new email. Don’t forget to attach your
            photos.
          </p>
        </div>
      </div>
      <a
        id="open-email"
        href="mailto:belmont@belmont.wa.gov.au"
        class="mt-5 inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-brand px-5 py-3 text-center text-sm font-semibold text-white transition hover:bg-brand-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand sm:w-auto"
      >
        Open draft in your email app
      </a>
      <dl class="mt-5 grid gap-2 text-sm wrap-anywhere sm:grid-cols-[5rem_minmax(0,1fr)]">
        <dt class="font-semibold text-brand-dark">To</dt>
        <dd>belmont@belmont.wa.gov.au</dd>
        <dt class="font-semibold text-brand-dark">CC</dt>
        <dd id="email-cc">Not selected</dd>
        <dt class="font-semibold text-brand-dark">Subject</dt>
        <dd id="email-subject">Tree concern at [insert address]</dd>
      </dl>
      <pre id="email-preview" class="mt-4 max-h-[34rem] overflow-auto whitespace-pre-wrap wrap-anywhere rounded-lg border border-gray-200 bg-white p-4 font-body text-base leading-relaxed text-ink"></pre>
      <div class="mt-5 border-t border-brand-light pt-5">
        <p class="text-sm font-semibold text-brand-dark">If you need to copy the draft instead</p>
        <div class="mt-3 grid gap-3 sm:grid-cols-3">
          <button
            id="copy-to"
            type="button"
            class="inline-flex min-h-11 items-center justify-center rounded-lg border border-brand-light bg-white px-4 py-3 text-sm font-semibold text-brand-dark transition hover:border-brand hover:bg-brand-light/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
          >
            Copy address
          </button>
          <button
            id="copy-subject"
            type="button"
            class="inline-flex min-h-11 items-center justify-center rounded-lg border border-brand-light bg-white px-4 py-3 text-sm font-semibold text-brand-dark transition hover:border-brand hover:bg-brand-light/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
          >
            Copy subject
          </button>
          <button
            id="copy-email"
            type="button"
            class="inline-flex min-h-11 items-center justify-center rounded-lg border border-brand-light bg-white px-4 py-3 text-sm font-semibold text-brand-dark transition hover:border-brand hover:bg-brand-light/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
          >
            Copy full email
          </button>
        </div>
      </div>
      <p id="copy-status" class="mt-3 min-h-5 text-sm font-semibold text-brand" aria-live="polite"></p>
    </section>

    <section
      aria-label="Protect a tree stats"
      data-email-workflow
      class="mt-6 grid gap-3 rounded-xl border border-brand-light bg-brand-light/15 p-4 sm:grid-cols-[auto_1fr] sm:items-center sm:gap-6 sm:px-6 sm:py-5"
    >
      <dl>
        <div class="flex items-center gap-3">
          <dt class="order-2 text-sm font-semibold leading-snug text-brand-dark">
            Protect a tree<br />assists
          </dt>
          <dd
            data-assist-count="protect-a-tree"
            class="order-1 shrink-0 font-heading text-3xl font-bold tabular-nums text-brand-dark"
          >
            {protectATreeAssists.toLocaleString('en-AU')}
          </dd>
        </div>
      </dl>
      <p class="text-sm leading-relaxed text-muted sm:border-l sm:border-brand-light sm:pl-6">
        Nice work, Belmont! By creating your email with this tool, you’re speaking up for local
        trees and helping care for our environment. That’s +1 to our tally of ‘Protect a tree
        assists’. Let’s see how many trees we can protect together!
      </p>
    </section>

    <section class="mt-8 border-t border-brand-light pt-6 sm:mt-10" aria-labelledby="keep-involved-heading">
      <h2 id="keep-involved-heading" class="font-heading text-2xl font-bold text-brand-dark">
        More from BCEC
      </h2>
      <div class="mt-5 grid gap-3 sm:grid-cols-2">
        <a href="/submissions/bcec-submission-draft-local-planning-policy-21-2026-05-13.pdf" target="_blank" rel="noopener noreferrer" class="related-link">
          Read BCEC’s Local Planning Policy No. 21 support letter
        </a>
        <a href="/projects" class="related-link">
          Explore BCEC community projects
        </a>
        <a href="/events" class="related-link">
          View upcoming BCEC events
        </a>
        <a href={forms.membership} target="_blank" rel="noopener noreferrer" class="related-link">
          Become a BCEC member
        </a>
        <a href="/" class="related-link">
          Visit the BCEC homepage
        </a>
      </div>
    </section>
  </div>

  <style>
    @reference '../../styles/global.css';

    #tree-concern-form label {
      @apply text-base;
    }

    /* Keep repeated form cards aligned with the site's bordered secondary actions. */
    #tree-concern-form label:has(input[type='checkbox']) {
      @apply min-h-11 transition hover:border-brand focus-within:border-brand focus-within:ring-2 focus-within:ring-brand/20 has-checked:border-brand has-checked:bg-brand-light/15;
    }

    #tree-concern-form input[type='checkbox'] {
      @apply focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand;
    }

    .related-link {
      @apply flex min-h-11 items-center rounded-lg border border-brand-light bg-white p-4 text-sm font-semibold leading-relaxed text-brand-dark transition hover:border-brand hover:bg-brand-light/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand;
    }

    [data-email-workflow][hidden] {
      display: none;
    }
  </style>

  <script>
    const form = document.querySelector<HTMLFormElement>('#tree-concern-form');
    const exemptTreeType = document.querySelector<HTMLInputElement>('#exempt-tree-type');
    const exemptionGuidance = document.querySelector<HTMLElement>('#exempt-tree-guidance');
    const exemptTypeGuidance = document.querySelector<HTMLElement>('#exempt-tree-type-guidance');
    const sizeGuidance = document.querySelector<HTMLElement>('#tree-size-guidance');
    const continuationGuidance = document.querySelector<HTMLElement>('#template-continuation-guidance');
    const emailWorkflow = document.querySelectorAll<HTMLElement>('[data-email-workflow]');
    const addressInput = document.querySelector<HTMLInputElement>('#tree-address');
    let addressAttempted = false;
    const preview = document.querySelector<HTMLElement>('#email-preview');
    const subjectElement = document.querySelector<HTMLElement>('#email-subject');
    const ccElement = document.querySelector<HTMLElement>('#email-cc');
    const openEmail = document.querySelector<HTMLAnchorElement>('#open-email');
    const copyToButton = document.querySelector<HTMLButtonElement>('#copy-to');
    const copySubjectButton = document.querySelector<HTMLButtonElement>('#copy-subject');
    const copyButton = document.querySelector<HTMLButtonElement>('#copy-email');
    const copyStatus = document.querySelector<HTMLElement>('#copy-status');
    const urgentSuggestion = document.querySelector<HTMLElement>('#urgent-suggestion');
    const trackedAssistButtons = new Set<string>();
    const lastTrackedAt = new Map<string, number>();
    const trackThrottleMs = 1500;
    const assistCampaign = 'protect-a-tree';
    const assistNumberFormat = new Intl.NumberFormat('en-AU');

    const updateAssistCount = (value: unknown) => {
      if (typeof value !== 'number' || !Number.isFinite(value)) return;
      document
        .querySelectorAll<HTMLElement>('[data-assist-count="protect-a-tree"]')
        .forEach((el) => {
          el.textContent = assistNumberFormat.format(value);
        });
    };

    // Show the live server-verified count on load (static snapshot is the
    // fallback if the endpoint is unreachable, e.g. local dev without functions).
    const loadAssistCount = async () => {
      try {
        const response = await fetch('/api/advocacy-assist', {
          headers: { Accept: 'application/json' },
        });
        if (!response.ok) return;
        const data = await response.json();
        updateAssistCount(data?.campaigns?.['protect-a-tree']);
      } catch {
        // Keep the static snapshot value on any error.
      }
    };

    // Server-verified assist counter (Netlify Function + Blobs). Best-effort and
    // non-blocking: failures never interrupt the user's email workflow.
    const recordServerAssist = (event: string) => {
      try {
        void fetch('/api/advocacy-assist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ campaign: assistCampaign, event }),
          keepalive: true,
        })
          .then((response) => (response.ok ? response.json() : null))
          .then((data) => updateAssistCount(data?.campaignTotal))
          .catch(() => {});
      } catch {
        // Ignore — tracking must never block the user.
      }
    };

    const trackAssist = (buttonKey: string, event: string) => {
      const now = Date.now();
      const last = lastTrackedAt.get(buttonKey) ?? 0;
      if (trackedAssistButtons.has(buttonKey) || now - last < trackThrottleMs) return;

      lastTrackedAt.set(buttonKey, now);
      trackedAssistButtons.add(buttonKey);

      // Record to the server-verified counter (Netlify Function + Blobs).
      recordServerAssist(event);
    };

    const fieldValue = (name: string) => {
      const field = form?.elements.namedItem(name);
      return field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement
        ? field.value.trim()
        : '';
    };

    const checkedValues = (name: string) =>
      Array.from(form?.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`) ?? [])
        .map((input) => input.value);

    const joinReasons = (reasons: string[]) => {
      if (reasons.length < 2) return reasons[0] ?? '';
      if (reasons.length === 2) return `${reasons[0]} and ${reasons[1]}`;
      return `${reasons.slice(0, -1).join(', ')}, and ${reasons.at(-1)}`;
    };

    const formatDate = (value: string) => {
      if (!value) return '';
      const [year, month, day] = value.split('-');
      return year && month && day ? `${day}/${month}/${year}` : value;
    };

    const encodeMailtoValue = (value: string) => encodeURIComponent(value);

    const buildEmail = () => {
      const selectedMeasurements = checkedValues('measurement');
      const exempt = exemptTreeType?.checked ?? false;
      const missingSize = (addressAttempted || fieldValue('address') !== '') && selectedMeasurements.length === 0;
      if (exemptionGuidance) exemptionGuidance.hidden = !(exempt || missingSize);
      if (exemptTypeGuidance) exemptTypeGuidance.hidden = !exempt;
      if (sizeGuidance) sizeGuidance.hidden = exempt || !missingSize;
      if (continuationGuidance) continuationGuidance.hidden = exempt;
      emailWorkflow.forEach((element) => {
        element.hidden = exempt;
        if (element instanceof HTMLFieldSetElement) element.disabled = exempt;
      });
      [copyToButton, copySubjectButton, copyButton].forEach((button) => {
        if (button) button.disabled = exempt;
      });
      if (openEmail) {
        if (exempt) {
          openEmail.removeAttribute('href');
          openEmail.setAttribute('aria-disabled', 'true');
        } else {
          openEmail.removeAttribute('aria-disabled');
        }
      }
      if (exempt) {
        if (preview) preview.textContent = '';
        if (copyStatus) copyStatus.textContent = '';
        return null;
      }
      const address = fieldValue('address') || '[insert full address]';
      const measurementDescriptions: Record<string, string> = {
        height: 'a height of approximately 8 metres or more',
        canopy: 'an average canopy width of approximately 6 metres or more',
        trunk: 'a trunk circumference of approximately 1.5 metres or more when measured 1.4 metres above ground',
      };
      const riskReasons = checkedValues('riskReason');
      const riskOther = fieldValue('riskOther');
      const hasPhotos = form?.querySelector<HTMLInputElement>('input[name="hasPhotos"]')?.checked ?? false;
      const photoDate = formatDate(fieldValue('photoDate')) || '[insert date]';
      const photoTime = fieldValue('photoTime') || '[insert time]';
      const senderName = fieldValue('senderName') || '[insert your name]';
      const senderEmail = fieldValue('senderEmail');
      const senderPhone = fieldValue('senderPhone');
      const urgent = form?.querySelector<HTMLInputElement>('input[name="urgent"]')?.checked ?? false;
      const copyBcec = form?.querySelector<HTMLInputElement>('input[name="copyBcec"]:checked');
      const urgencySuggested = form?.querySelector<HTMLInputElement>('input[data-suggest-urgent]:checked') !== null;

      if (riskOther) riskReasons.push(riskOther);

      const knownMeasurements = selectedMeasurements
        .map((measurement) => measurementDescriptions[measurement])
        .filter(Boolean);
      const policyDetails = knownMeasurements.length
        ? `From what I can tell, the tree has ${joinReasons(knownMeasurements)}, so the activity may not qualify for the size-based exemption in clause 5.1.1(a).`
        : '';
      const policyStatement = `Local Planning Policy No. 21 sets out when tree damaging activity is exempt from development approval. ${policyDetails || 'I am unsure whether the reported activity outlined above is exempt.'}`;
      const riskStatement = riskReasons.length
        ? `I'm concerned that this tree may be removed or damaged because ${joinReasons(riskReasons)}.`
        : `I'm concerned that this tree may be removed or damaged because [insert reason for concern].`;
      const photoStatement = hasPhotos
        ? `I have attached photos of the tree taken on ${photoDate} at ${photoTime} to assist Council in identifying the tree and assessing the concern.`
        : '';
      const contactLines = [senderEmail, senderPhone].filter(Boolean).join('\n') || '[insert your contact details]';
      const subject = `${urgent ? 'URGENT: ' : ''}Tree concern at ${address}`;
      const body = `Hi Planning team,

I'm a local resident and I'm concerned about a tree at ${address}.

${riskStatement}

${photoStatement}

${policyStatement}

I respectfully request that Council note this concern, inspect the tree if appropriate, and advise the property owner, developer, or relevant parties of any applicable requirements or protections under Local Planning Policy No. 21.

Thanks for looking into this. Please let me know that you received this email and what happens next.

Kind regards,
${senderName}
${contactLines}`.replace(/\n{3,}/g, '\n\n');
  const cc = [urgent ? 'planning@belmont.wa.gov.au' : '', copyBcec?.value ?? '']
    .filter(Boolean)
    .join(',');

      if (preview) preview.textContent = body;
      if (subjectElement) subjectElement.textContent = subject;
      if (ccElement) ccElement.textContent = cc || 'Not selected';
      if (urgentSuggestion) urgentSuggestion.hidden = !urgencySuggested;
      if (openEmail) {
        const params = [`subject=${encodeMailtoValue(subject)}`, `body=${encodeMailtoValue(body)}`];
        if (cc) params.push(`cc=${encodeMailtoValue(cc)}`);
        openEmail.href = `mailto:belmont@belmont.wa.gov.au?${params.join('&')}`;
      }

      return { subject, body, cc };
    };

    addressInput?.addEventListener('focus', () => {
      addressAttempted = true;
      buildEmail();
    });
    form?.addEventListener('input', buildEmail);
    openEmail?.addEventListener('click', (event) => {
      if (!buildEmail()) {
        event.preventDefault();
        return;
      }
      trackAssist('open-email', 'advocacy-protect-tree-open-email');
    });
    copyToButton?.addEventListener('click', async () => {
      const draft = buildEmail();
      if (!draft) return;
      const { cc } = draft;
      try {
        await navigator.clipboard.writeText(`belmont@belmont.wa.gov.au${cc ? `\nCC: ${cc}` : ''}`);
        if (copyStatus) copyStatus.textContent = 'Email address copied.';
      } catch {
        if (copyStatus) copyStatus.textContent = 'Copy failed. You can type the address manually.';
      }
    });
    copySubjectButton?.addEventListener('click', async () => {
      const draft = buildEmail();
      if (!draft) return;
      const { subject } = draft;
      try {
        await navigator.clipboard.writeText(subject);
        if (copyStatus) copyStatus.textContent = 'Subject copied.';
      } catch {
        if (copyStatus) copyStatus.textContent = 'Copy failed. You can type the subject manually.';
      }
    });
    copyButton?.addEventListener('click', async () => {
      const draft = buildEmail();
      if (!draft) return;
      const { subject, body, cc } = draft;
      const headers = `To: belmont@belmont.wa.gov.au\n${cc ? `CC: ${cc}\n` : ''}Subject: ${subject}`;
      try {
        await navigator.clipboard.writeText(`${headers}\n\n${body}`);
        trackAssist('copy-email', 'advocacy-protect-tree-copy-full-email');
        if (copyStatus) copyStatus.textContent = 'Email copied to clipboard.';
      } catch {
        if (copyStatus) copyStatus.textContent = 'Copy failed. Select and copy the email text above.';
      }
    });

    buildEmail();
    loadAssistCount();
  </script>
</BaseLayout>