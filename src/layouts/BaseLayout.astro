---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Hide the page from search engines (used for private admin pages). */
  noindex?: boolean;
}

const { title, description, image, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Netlify Identity invite and password-recovery emails link to the site root.
      if (
        /^#(invite_token|recovery_token|confirmation_token|email_change_token|access_token)=/.test(location.hash) &&
        location.pathname.replace(/\/$/, '') !== '/admin/login'
      ) {
        location.replace('/admin/login/' + location.hash);
      }
    </script>
    <link
      rel="icon"
      type="image/svg+xml"
      href="/site_assets/White%20Blurred%20Favicon%20Background.svg"
    />
    <meta name="generator" content={Astro.generator} />
    <!-- Brand font: "Nunito" as a free substitute for the brand's Canva Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap"
    />
    <SEO title={title} description={description} image={image} noindex={noindex} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:rounded focus:bg-brand focus:px-3 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      import { initSiteMetrics } from '../scripts/site-metrics';
      initSiteMetrics();
    </script>
  </body>
</html>
