---
import BaseLayout from '../layouts/BaseLayout.astro';
import { forms, socials } from '../config';
---

<BaseLayout
  title="Get Involved"
  description="Become a member of BCEC and help drive local environmental action. Sign up in minutes."
>
  <section class="mx-auto max-w-2xl px-4 py-12 text-center">
    <h1 class="font-heading text-3xl font-bold text-brand-dark sm:text-4xl">Get involved</h1>
    <p class="mt-4 text-muted">
      Whether you can spare an hour or a weekend, there's a place for you. Become a member to
      hear about upcoming events, help shape our projects, and join a friendly community caring
      for our local environment.
    </p>

    <a
      href={forms.membership}
      target="_blank"
      rel="noopener"
      class="mt-8 inline-block rounded-lg bg-brand px-8 py-4 text-lg font-semibold text-white transition hover:bg-brand-dark"
    >
      Become a member
    </a>
    <p class="mt-2 text-xs text-muted">Opens our membership form in a new tab.</p>

    <div class="mt-8 rounded-xl border border-brand-light bg-brand-light/30 p-5 text-left sm:p-6">
      <p class="text-sm font-semibold uppercase tracking-wide text-brand">Take action</p>
      <h2 class="mt-2 font-heading text-xl font-bold text-brand-dark sm:text-2xl">
        Concerned about a tree?
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-muted sm:text-base">
        If you think a private tree may be at risk of removal or damage, use our guided email
        template to contact the City of Belmont.
      </p>
      <a
        href="/advocacy/protect-a-tree"
        class="mt-5 inline-flex min-h-11 items-center justify-center rounded-lg border border-brand px-5 py-3 font-semibold text-brand transition hover:bg-brand-light focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
      >
        Create a tree concern email
      </a>
    </div>

    {
      socials.email && (
        <div class="mt-10 rounded-xl border border-brand-light bg-brand-light/40 p-5 text-center">
          <h2 class="font-heading text-lg font-bold text-brand-dark">Contact us</h2>
          <p class="mt-2 text-sm text-muted">
            Not on Facebook or Instagram? Email us directly and we will get back to you.
          </p>
          <a
            href={`mailto:${socials.email}`}
            class="mt-3 inline-block font-semibold text-brand underline underline-offset-2 hover:text-brand-dark"
          >
            {socials.email}
          </a>
        </div>
      )
    }

    <div class="mt-12 border-t border-gray-100 pt-8">
      <h2 class="font-heading text-lg font-bold text-brand-dark">Follow along</h2>
      <p class="mt-2 text-sm text-muted">
        Keep up with our latest events and wins on social media.
      </p>
      <div class="mt-4 flex justify-center gap-4">
        {
          socials.facebook && (
            <a
              href={socials.facebook}
              target="_blank"
              rel="noopener"
              class="inline-flex h-12 w-12 items-center justify-center rounded-full border border-brand text-brand transition hover:bg-brand-light"
              aria-label="Facebook"
              title="Facebook"
            >
              <svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor" aria-hidden="true">
                <path d="M13.5 22v-8h2.7l.4-3h-3.1V9.1c0-.9.3-1.6 1.6-1.6h1.7V4.8c-.3 0-1.3-.1-2.5-.1-2.5 0-4.1 1.5-4.1 4.3V11H7.9v3h2.8v8h2.8z"></path>
              </svg>
              <span class="sr-only">Facebook</span>
            </a>
          )
        }
        {
          socials.instagram && (
            <a
              href={socials.instagram}
              target="_blank"
              rel="noopener"
              class="inline-flex h-12 w-12 items-center justify-center rounded-full border border-brand text-brand transition hover:bg-brand-light"
              aria-label="Instagram"
              title="Instagram"
            >
              <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5" ry="5"></rect>
                <circle cx="12" cy="12" r="4"></circle>
                <circle cx="17" cy="7" r="1"></circle>
              </svg>
              <span class="sr-only">Instagram</span>
            </a>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>
