---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { advocacyMetrics } from '../../data/advocacy-metrics';

const dateFmt = new Intl.DateTimeFormat('en-AU', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const submissions = (await getCollection('advocacySubmissions'))
  .filter((entry) => !entry.id.startsWith('_') && !entry.filePath?.toLowerCase().includes('_template.md'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const submissionsLodged = submissions.length;
const advocacyAssists = advocacyMetrics.advocacyAssistsTotal;
const protectATreeAssists = advocacyMetrics.campaignAssists['protect-a-tree'] ?? 0;
---

<BaseLayout
  title="Advocacy"
  description="Use BCEC community advocacy resources and read our submissions on environmental planning, transport and issues affecting the City of Belmont."
>
  <section class="bg-brand-light/50">
    <div class="mx-auto max-w-5xl px-4 py-6 sm:px-6">
      <p class="inline-flex rounded-full bg-brand-dark px-3 py-1 text-xs font-semibold uppercase tracking-wide text-white">
        Community voice
      </p>
      <h1 class="mt-4 font-heading text-3xl font-bold text-brand-dark sm:text-4xl">
        Advocacy
      </h1>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-muted sm:text-lg">
        We help our community speak up for a cleaner, greener and more connected City of
        Belmont. Take practical action or read our advocacy submissions.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10 sm:px-6 sm:py-12">
    <div class="grid items-center gap-6 border-b border-brand-light pb-10 sm:pb-12 lg:grid-cols-[minmax(0,1fr)_auto]">
      <div class="min-w-0">
        <p class="text-sm font-semibold uppercase tracking-wide text-brand">Take action</p>
        <h2 class="mt-2 font-heading text-2xl font-bold text-brand-dark">
          Concerned about a tree?
        </h2>
        <p class="mt-3 max-w-2xl leading-relaxed text-ink">
          If you believe a private tree may be at risk of removal or damage, use our guided
          template to report your concern to the City of Belmont.
        </p>
      </div>
      <a
        href="/advocacy/protect-a-tree"
        class="inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-brand px-5 py-3 text-center text-sm font-semibold text-white transition hover:bg-brand-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand sm:w-fit"
      >
        Create a tree concern email
      </a>
    </div>

    <div class="mt-8 rounded-xl bg-surface p-4 sm:p-6">
      <dl class="grid grid-cols-2 items-start gap-4 text-center sm:grid-cols-3 sm:gap-6">
        <div class="col-span-2 flex flex-col sm:col-span-1">
          <dt class="order-2 text-xs uppercase tracking-wide text-muted">Submissions lodged</dt>
          <dd class="order-1 font-heading text-3xl font-bold tabular-nums text-brand">
            {submissionsLodged.toLocaleString('en-AU')}
          </dd>
        </div>
        <div class="flex flex-col">
          <dt class="order-2 text-xs uppercase tracking-wide text-muted">Advocacy assists</dt>
          <dd
            id="advocacy-assists-count"
            data-assist-count="total"
            class="order-1 font-heading text-3xl font-bold tabular-nums text-brand"
          >
            {advocacyAssists.toLocaleString('en-AU')}
          </dd>
        </div>
        <div class="flex flex-col">
          <dt class="order-2 text-xs uppercase tracking-wide text-muted">Protect a tree</dt>
          <dd
            id="protect-a-tree-count"
            data-assist-count="protect-a-tree"
            class="order-1 font-heading text-3xl font-bold tabular-nums text-brand"
          >
            {protectATreeAssists.toLocaleString('en-AU')}
          </dd>
        </div>
      </dl>
      <p class="mt-5 border-t border-brand-light pt-4 text-sm leading-relaxed text-muted">
        We make submissions and write to decision-makers to stand up for Belmont’s environment.
        We also help our community speak up through tools like Protect a tree. Each time someone
        opens or copies their draft email, we count an advocacy assist: a time we’ve helped
        someone prepare to advocate for our local environment.
      </p>
    </div>
  </section>

  <section id="submissions" class="mx-auto max-w-5xl scroll-mt-24 px-4 pb-12 sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-wide text-brand">Our work</p>
    <h2 class="mt-2 font-heading text-2xl font-bold text-brand-dark">Published submissions</h2>
    <p class="mt-3 max-w-3xl leading-relaxed text-muted">
      BCEC contributes local environmental perspectives to government consultations and
      policy discussions.
    </p>
    <div class="mt-6 grid gap-4">
      {
        submissions.map((submission) => (
          <article class="rounded-xl border border-brand-light bg-white p-4 shadow-sm sm:p-6">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
              <div class="min-w-0">
                <h3 class="font-heading text-lg font-bold text-brand-dark sm:text-xl">
                  {submission.data.title}
                </h3>
                <p class="mt-1 text-sm text-muted">{submission.data.type}</p>
              </div>
              <span class="inline-flex w-fit shrink-0 rounded-full bg-brand px-3 py-1 text-xs font-semibold uppercase tracking-wide text-white">
                Submitted
              </span>
            </div>

            <dl class="mt-5 grid gap-3 text-sm text-ink sm:grid-cols-2">
              <div>
                <dt class="font-semibold text-brand-dark">Date</dt>
                <dd>
                  <time datetime={submission.data.date.toISOString()}>
                    {dateFmt.format(submission.data.date)}
                  </time>
                </dd>
              </div>
              <div>
                <dt class="font-semibold text-brand-dark">Recipient</dt>
                <dd>{submission.data.recipient}</dd>
              </div>
            </dl>

            <p class="mt-5 text-sm leading-relaxed text-ink sm:text-base">{submission.data.summary}</p>

            <div class="mt-5 flex flex-col gap-2 sm:flex-row sm:flex-wrap">
              {submission.data.documents.map((document) => (
                <a
                  href={document.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex min-h-11 items-center justify-center rounded-lg bg-brand px-4 py-3 text-center text-sm font-semibold text-white transition hover:bg-brand-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
                >
                  {document.label}
                </a>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <script>
    // Progressive enhancement: replace the build-time snapshot numbers with the
    // live server-verified totals when the endpoint is reachable. If the fetch
    // fails (e.g. local dev without functions), the static numbers remain.
    const numberFormat = new Intl.NumberFormat('en-AU');

    const applyLiveCounts = async () => {
      try {
        const response = await fetch('/api/advocacy-assist', {
          headers: { Accept: 'application/json' },
        });
        if (!response.ok) return;

        const data = await response.json();
        const campaigns =
          data && typeof data.campaigns === 'object' && data.campaigns !== null
            ? data.campaigns
            : {};

        document.querySelectorAll<HTMLElement>('[data-assist-count]').forEach((el) => {
          const key = el.dataset.assistCount ?? '';
          const value = key === 'total' ? data?.total : campaigns[key];
          if (typeof value === 'number' && Number.isFinite(value)) {
            el.textContent = numberFormat.format(value);
          }
        });
      } catch {
        // Keep the static snapshot values on any error.
      }
    };

    applyLiveCounts();
  </script>
</BaseLayout>