---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCard from '../../components/EventCard.astro';
import CategoryPills from '../../components/CategoryPills.astro';
import { resolveCategories } from '../../content/categories';

const now = new Date();
const all = await getCollection('events', ({ data }) => !data.draft);

const upcoming = all
  .filter((e) => e.data.start >= now)
  .sort((a, b) => a.data.start.valueOf() - b.data.start.valueOf());

const past = all
  .filter((e) => e.data.start < now)
  .sort((a, b) => b.data.start.valueOf() - a.data.start.valueOf())
  .slice(0, 6);

const dayMonthYear = new Intl.DateTimeFormat('en-AU', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});

// One-line impact for a past-event tile: an explicit `impact` line if the
// committee wrote one, otherwise derive it from the first stat or funds raised.
function impactLine(data: (typeof past)[number]['data']): string | null {
  if (data.impact) return data.impact;
  if (data.stats && data.stats.length > 0) {
    const s = data.stats[0];
    return `${s.value} ${s.label.toLowerCase()}`;
  }
  if (data.raised && data.raised > 0) {
    return `$${data.raised.toLocaleString('en-AU', {
      minimumFractionDigits: data.raised % 1 === 0 ? 0 : 2,
      maximumFractionDigits: 2,
    })} raised for BCEC`;
  }
  return null;
}
---

<BaseLayout
  title="Events"
  description="Upcoming BCEC community events — clean-ups, tree planting and more. Register via our online forms."
>
  <section class="mx-auto max-w-5xl px-4 py-12">
    <h1 class="font-heading text-3xl font-bold text-brand-dark sm:text-4xl">Upcoming events</h1>
    <p class="mt-3 text-muted">
      Join us at our next community event. Click <strong>Register</strong> to sign up via our
      online form.
    </p>

    {
      upcoming.length > 0 ? (
        <div class="mt-8 space-y-4">
          {upcoming.map((event) => (
            <EventCard
              title={event.data.title}
              categories={resolveCategories(event.data)}
              start={event.data.start}
              end={event.data.end}
              location={event.data.location}
              summary={event.data.summary}
              registerUrl={event.data.registerUrl}
              href={`/events/${event.id}`}
              slug={event.id}
            />
          ))}
        </div>
      ) : (
        <p class="mt-8 rounded-xl bg-surface p-6 text-muted">
          No events scheduled right now — follow us on social media to hear about the next one.
        </p>
      )
    }

    {
      past.length > 0 && (
        <div class="mt-14">
          <h2 class="font-heading text-xl font-bold text-brand-dark">Past events</h2>
          <div class="mt-4 grid gap-5 sm:grid-cols-2">
            {past.map((event) => {
              const impact = impactLine(event.data);
              return (
                <a
                  href={`/events/${event.id}`}
                  class="group flex flex-col overflow-hidden rounded-xl border border-gray-100 bg-white shadow-sm transition hover:shadow-md"
                >
                  <div class="aspect-video overflow-hidden bg-brand-light">
                    {event.data.image ? (
                      <img
                        src={event.data.image}
                        alt={event.data.imageAlt ?? event.data.title}
                        class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
                        loading="lazy"
                      />
                    ) : (
                      <div class="flex h-full w-full items-center justify-center text-brand/50">
                        <svg class="h-10 w-10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d="M12 2C7 6 5 10 5 14a7 7 0 0014 0c0-4-2-8-7-12zm0 18a5 5 0 01-5-5c0-2.7 1.3-5.6 5-8.9 3.7 3.3 5 6.2 5 8.9a5 5 0 01-5 5z" />
                        </svg>
                      </div>
                    )}
                  </div>
                  <div class="flex flex-1 flex-col p-4">
                    <CategoryPills categories={resolveCategories(event.data)} class="mb-2" />
                    <time
                      class="text-xs uppercase tracking-wide text-muted"
                      datetime={event.data.start.toISOString()}
                    >
                      {dayMonthYear.format(event.data.start)}
                    </time>
                    <h3 class="mt-1 font-heading text-lg font-bold text-brand-dark group-hover:text-brand">
                      {event.data.title}
                    </h3>
                    {impact ? (
                      <p class="mt-1 text-sm font-medium text-brand">{impact}</p>
                    ) : (
                      <p class="mt-1 text-sm italic text-muted">Write-up coming soon</p>
                    )}
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      )
    }
  </section>
</BaseLayout>
