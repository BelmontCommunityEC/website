---
import { getCollection } from 'astro:content';
import AdminNav from '../../../components/AdminNav.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  CATEGORY_OPTIONS,
  MAX_GALLERY_PHOTOS,
  METRIC_OPTIONS,
  ORGANISATION_OPTIONS,
  ROLE_OPTIONS,
} from '../../../lib/event-draft.ts';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .map((project) => ({ id: project.id, title: project.data.title }))
  .sort((a, b) => a.title.localeCompare(b.title));

const roleLabel = (role: string) => role.charAt(0).toUpperCase() + role.slice(1);
---

<BaseLayout title="Draft an event" description="Draft a new BCEC event for review." noindex>
  <AdminNav current="event" />
  <section class="mx-auto w-full max-w-3xl px-4 py-6 sm:py-10" aria-labelledby="drafter-heading">
    <p class="inline-flex rounded-full bg-brand-dark px-3 py-1 text-xs font-semibold uppercase tracking-wide text-white">
      Committee only
    </p>
    <h1 id="drafter-heading" class="mt-3 font-heading text-3xl font-bold text-brand-dark sm:text-4xl">Draft an event</h1>
    <p class="mt-2 text-base leading-relaxed text-ink">
      Fill in what you know, then send it for review. Nothing goes live until a reviewer checks the preview and
      approves it on GitHub.
    </p>
    <p id="drafter-status" class="mt-3 min-h-6 text-sm font-semibold text-brand-dark" role="status" aria-live="polite"></p>

    <div id="restored-note" class="mt-4 rounded-lg border border-brand-light bg-brand-light/30 p-4 text-sm leading-relaxed text-ink" hidden>
      We’ve restored your unsent draft. Photos need to be added again.
      <button id="start-over" type="button" class="draft-link">Start a new draft instead</button>
    </div>

    <div id="error-summary" class="mt-6 rounded-lg border-l-4 border-red-700 bg-red-50 p-4" role="alert" tabindex="-1" hidden>
      <h2 class="font-heading text-lg font-bold text-red-800">Some details need fixing</h2>
      <ul id="error-list" class="mt-2 list-disc space-y-1 pl-5 text-sm text-red-800"></ul>
    </div>

    <form id="event-form" class="mt-6 space-y-8" novalidate>
      <section class="draft-card" aria-labelledby="basics-heading">
        <h2 id="basics-heading" class="draft-heading">The basics</h2>

        <div class="mt-4 space-y-5">
          <div>
            <label class="draft-label" for="title">Event name</label>
            <input id="title" name="title" type="text" maxlength="120" required class="draft-input" autocomplete="off" />
            <p class="field-error" data-error-for="title" hidden></p>
          </div>

          <div>
            <label class="draft-label" for="slug">Web address</label>
            <div class="mt-2 flex min-w-0 items-stretch overflow-hidden rounded-lg border border-gray-300 bg-white focus-within:border-brand focus-within:ring-2 focus-within:ring-brand/20">
              <span class="flex shrink-0 items-center bg-surface px-3 text-sm text-muted">/events/</span>
              <input id="slug" name="slug" type="text" maxlength="80" class="min-h-11 min-w-0 flex-1 px-3 py-2 text-base text-ink focus:outline-none" autocomplete="off" aria-describedby="slug-help" />
            </div>
            <p id="slug-help" class="draft-help">Filled in from the name and date. Lowercase letters, numbers and hyphens only.</p>
            <p class="field-error" data-error-for="slug" hidden></p>
          </div>

          <fieldset id="categories-group" tabindex="-1">
            <legend class="draft-label">Categories</legend>
            <div class="mt-2 grid gap-2 sm:grid-cols-2">
              {CATEGORY_OPTIONS.map((category) => (
                <label class="draft-check">
                  <input type="checkbox" name="categories" value={category} class="h-5 w-5 flex-none accent-brand" />
                  <span>{category}</span>
                </label>
              ))}
            </div>
            <p class="field-error" data-error-for="categories" hidden></p>
          </fieldset>

          <div class="grid gap-4 sm:grid-cols-3">
            <div>
              <label class="draft-label" for="date">Date</label>
              <input id="date" name="date" type="date" required class="draft-input" />
              <p class="field-error" data-error-for="date" hidden></p>
            </div>
            <div>
              <label class="draft-label" for="startTime">Start time</label>
              <input id="startTime" name="startTime" type="time" required class="draft-input" />
              <p class="field-error" data-error-for="startTime" hidden></p>
            </div>
            <div>
              <label class="draft-label" for="endTime">End time <span class="font-normal text-muted">(optional)</span></label>
              <input id="endTime" name="endTime" type="time" class="draft-input" />
              <p class="field-error" data-error-for="endTime" hidden></p>
            </div>
          </div>
          <p class="draft-help -mt-3">Perth time.</p>

          <div>
            <label class="draft-label" for="location">Where to meet</label>
            <input id="location" name="location" type="text" maxlength="160" required class="draft-input" placeholder="e.g. Garvey Park, Ascot" />
            <p class="field-error" data-error-for="location" hidden></p>
          </div>

          <div>
            <label class="draft-label" for="summary">Summary</label>
            <textarea id="summary" name="summary" rows="3" maxlength="400" required class="draft-input" aria-describedby="summary-help"></textarea>
            <p id="summary-help" class="draft-help">One or two sentences: what it is and what to bring. <span id="summary-count">0</span>/400</p>
            <p class="field-error" data-error-for="summary" hidden></p>
          </div>

          <div>
            <label class="draft-label" for="registerUrl">Registration link <span class="font-normal text-muted">(optional)</span></label>
            <input id="registerUrl" name="registerUrl" type="url" inputmode="url" class="draft-input" placeholder="https://forms.gle/…" />
            <p class="field-error" data-error-for="registerUrl" hidden></p>
          </div>

          <div>
            <label class="draft-label" for="project">Part of a project? <span class="font-normal text-muted">(optional)</span></label>
            <select id="project" name="project" class="draft-input">
              <option value="">No, it’s a standalone event</option>
              {projects.map((project) => <option value={project.id}>{project.title}</option>)}
            </select>
            <p class="draft-help">Events that belong to a project are counted in that project’s totals instead of the home page.</p>
            <p class="field-error" data-error-for="project" hidden></p>
          </div>
        </div>
      </section>

      <section class="draft-card" aria-labelledby="photos-heading">
        <h2 id="photos-heading" class="draft-heading">Photos <span class="text-base font-normal text-muted">(optional)</span></h2>
        <div class="mt-2 space-y-2 text-sm leading-relaxed text-muted">
          <p>
            Choose the <strong>original photos</strong> from your camera or phone. We make a sharp website copy (up to
            2560 pixels wide, high-quality JPEG) and remove location details. Keep the full-size originals in the
            committee’s Google Drive folder.
          </p>
          <p>Photos must be ones BCEC has permission to share, especially photos showing children.</p>
        </div>

        <div class="mt-5">
          <label class="draft-label" for="cover-file">Cover photo</label>
          <p class="draft-help">Shown at the top of the event page. Landscape photos work best.</p>
          <input id="cover-file" type="file" accept="image/*" class="draft-file" />
          <div id="cover-item" class="mt-3"></div>
          <p class="field-error" data-error-for="coverAlt" hidden></p>
        </div>

        <div class="mt-6">
          <label class="draft-label" for="gallery-files">More photos</label>
          <p class="draft-help">Up to {MAX_GALLERY_PHOTOS}. Shown in a grid on the event page.</p>
          <input id="gallery-files" type="file" accept="image/*" multiple class="draft-file" />
          <ul id="gallery-list" class="mt-3 space-y-3"></ul>
          <p class="field-error" data-error-for="gallery" hidden></p>
        </div>
        <p id="photo-status" class="mt-3 min-h-5 text-sm font-semibold text-brand-dark" role="status" aria-live="polite"></p>
      </section>

      <details id="after-event" class="draft-card group">
        <summary class="flex min-h-11 cursor-pointer items-center justify-between gap-3 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">
          <span>
            <span class="draft-heading block">After the event <span class="text-base font-normal text-muted">(optional)</span></span>
            <span class="mt-1 block text-sm text-muted">Impact, money raised, numbers, outcomes and partners.</span>
          </span>
          <span class="text-brand-dark transition group-open:rotate-180" aria-hidden="true">▾</span>
        </summary>

        <div class="mt-5 space-y-5">
          <div>
            <label class="draft-label" for="impact">One-line impact</label>
            <input id="impact" name="impact" type="text" maxlength="160" class="draft-input" placeholder="e.g. 4,000 native plants planted in a single morning" />
          </div>

          <div>
            <label class="draft-label" for="raised">Money raised <span class="font-normal text-muted">(fundraising only)</span></label>
            <input id="raised" name="raised" type="text" inputmode="decimal" class="draft-input sm:max-w-xs" placeholder="e.g. 1243.80" />
            <p class="field-error" data-error-for="raised" hidden></p>
          </div>

          <fieldset>
            <legend class="draft-label">Numbers</legend>
            <p class="draft-help">Only use numbers you can back up. Choose a home-page total to add the number to the site-wide figures.</p>
            <div id="stats-rows" class="mt-3 space-y-3"></div>
            <button id="add-stat" type="button" class="draft-secondary mt-3 sm:w-auto">Add a number</button>
          </fieldset>

          <div>
            <label class="draft-label" for="outcomes">Outcomes</label>
            <textarea id="outcomes" name="outcomes" rows="4" class="draft-input" aria-describedby="outcomes-help"></textarea>
            <p id="outcomes-help" class="draft-help">One per line. Shown as a checklist on the event page.</p>
          </div>

          <fieldset>
            <legend class="draft-label">Partners and supporters</legend>
            <p class="draft-help">Not listed? Ask the site administrator to add them first.</p>
            <div class="mt-3 grid gap-2">
              {ORGANISATION_OPTIONS.map((org) => (
                <div class="rounded-lg border border-gray-200 bg-white p-3" data-partner={org.id}>
                  <label class="flex min-h-11 cursor-pointer items-center gap-3 text-base">
                    <input type="checkbox" name="partners" value={org.id} class="h-5 w-5 flex-none accent-brand" />
                    <span>{org.name}</span>
                  </label>
                  <label class="mt-2 block text-sm font-semibold text-ink" hidden data-partner-role>
                    Role
                    <select name={`role-${org.id}`} class="draft-input">
                      <option value="">Default ({roleLabel(org.defaultRole)})</option>
                      {ROLE_OPTIONS.map((role) => <option value={role}>{roleLabel(role)}</option>)}
                    </select>
                  </label>
                </div>
              ))}
            </div>
          </fieldset>

          <div>
            <label class="draft-label" for="sourceNote">Where do the numbers come from?</label>
            <textarea id="sourceNote" name="sourceNote" rows="2" maxlength="1000" class="draft-input" aria-describedby="source-help"></textarea>
            <p id="source-help" class="draft-help">For reviewers, e.g. “Sign-in sheet and City of Belmont report”. Not shown on the website, but visible on GitHub.</p>
          </div>
        </div>
      </details>

      <section class="draft-card" aria-labelledby="body-heading">
        <h2 id="body-heading" class="draft-heading">More about the event <span class="text-base font-normal text-muted">(optional)</span></h2>
        <label class="sr-only" for="body">More about the event</label>
        <textarea id="body" name="body" rows="6" maxlength="6000" class="draft-input" aria-describedby="body-help"></textarea>
        <p id="body-help" class="draft-help">Extra paragraphs for the event page. Leave a blank line between paragraphs. Links must start with https://.</p>
        <p class="field-error" data-error-for="body" hidden></p>
      </section>

      <section class="draft-card" aria-labelledby="preview-heading">
        <h2 id="preview-heading" class="draft-heading">Preview</h2>
        <p class="mt-1 text-sm text-muted">How the event appears in the events list. The full page is checked in the review preview.</p>
        <div id="event-preview" class="mt-4"></div>
      </section>

      <section class="draft-card" aria-labelledby="submit-heading">
        <h2 id="submit-heading" class="draft-heading">Send for review</h2>
        <p class="mt-1 text-sm leading-relaxed text-muted">
          This creates a review request on GitHub with a preview of the website. A reviewer checks it and selects
          “Merge” to publish.
        </p>
        <div class="mt-4 grid gap-3 sm:flex sm:flex-wrap">
          <button id="submit-draft" type="submit" class="draft-primary">Send for review</button>
          <button id="clear-draft" type="button" class="draft-secondary sm:w-auto">Clear form</button>
        </div>
        <ol id="submit-progress" class="mt-4 space-y-1 text-sm text-ink" aria-live="polite"></ol>
        <div id="submit-result" class="mt-4 rounded-lg border-l-4 border-brand bg-brand-light/30 p-4" hidden tabindex="-1">
          <h3 class="font-heading text-lg font-bold text-brand-dark">Sent for review</h3>
          <p class="mt-1 text-sm leading-relaxed text-ink">
            The website preview takes about two minutes to build. Share the review link with whoever approves website
            changes.
          </p>
          <div class="mt-3 grid gap-3 sm:flex sm:flex-wrap">
            <a id="result-preview" class="draft-primary" target="_blank" rel="noopener noreferrer" data-no-track hidden>Open the preview</a>
            <a id="result-pr" class="draft-secondary sm:w-auto" target="_blank" rel="noopener noreferrer" data-no-track>Open the review on GitHub</a>
          </div>
        </div>
      </section>
    </form>
  </section>

  <template id="stat-row-template">
    <div class="rounded-lg border border-gray-200 bg-white p-3" data-stat-row>
      <div class="grid gap-3 sm:grid-cols-[minmax(0,2fr)_minmax(0,1fr)_minmax(0,2fr)]">
        <label class="block text-sm font-semibold text-ink">
          Label
          <input name="stat-label" type="text" maxlength="80" class="draft-input" placeholder="e.g. Volunteers involved" />
        </label>
        <label class="block text-sm font-semibold text-ink">
          Number
          <input name="stat-value" type="text" maxlength="30" class="draft-input" placeholder="e.g. 30" />
        </label>
        <label class="block text-sm font-semibold text-ink">
          Home-page total
          <select name="stat-metric" class="draft-input">
            <option value="">Don’t add to totals</option>
            {METRIC_OPTIONS.map((metric) => <option value={metric.key}>{metric.label}</option>)}
          </select>
        </label>
      </div>
      <p class="field-error" data-stat-error hidden></p>
      <button type="button" class="draft-link mt-2" data-remove-stat>Remove this number</button>
    </div>
  </template>

  <style is:global>
    @reference '../../../styles/global.css';

    .draft-card {
      @apply rounded-xl border border-brand-light bg-surface p-4 sm:p-6;
    }

    .draft-heading {
      @apply font-heading text-xl font-bold text-brand-dark;
    }

    .draft-label {
      @apply block text-sm font-semibold text-ink;
    }

    .draft-help {
      @apply mt-1 text-sm leading-relaxed text-muted;
    }

    .draft-input {
      @apply mt-2 min-h-11 w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-base font-normal text-ink focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20 aria-[invalid=true]:border-red-700;
    }

    .draft-file {
      @apply mt-2 block w-full max-w-full text-sm text-ink file:mr-3 file:min-h-11 file:cursor-pointer file:rounded-lg file:border file:border-brand-light file:bg-white file:px-4 file:py-2 file:text-sm file:font-semibold file:text-brand-dark hover:file:border-brand;
    }

    .draft-check {
      @apply flex min-h-11 cursor-pointer items-center gap-3 rounded-lg border border-gray-200 bg-white px-3 py-2 text-base transition hover:border-brand has-checked:border-brand has-checked:bg-brand-light/15;
    }

    .draft-primary {
      @apply inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-brand px-5 py-3 text-sm font-semibold text-white transition hover:bg-brand-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand disabled:cursor-wait disabled:opacity-70 sm:w-auto;
    }

    .draft-secondary {
      @apply inline-flex min-h-11 w-full items-center justify-center rounded-lg border border-brand-light bg-white px-4 py-3 text-sm font-semibold text-brand-dark transition hover:border-brand hover:bg-brand-light/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand disabled:cursor-not-allowed disabled:opacity-60;
    }

    .draft-link {
      @apply inline-flex min-h-11 items-center text-sm font-semibold text-brand-dark underline underline-offset-2 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand disabled:cursor-not-allowed disabled:opacity-60;
    }

    .field-error {
      @apply mt-1 text-sm font-semibold text-red-800;
    }

    .field-error[hidden],
    #error-summary[hidden],
    #restored-note[hidden],
    #submit-result[hidden],
    #result-preview[hidden],
    [data-partner-role][hidden] {
      display: none;
    }
  </style>

  <script>
    import { initEventDrafter } from '../../../scripts/event-drafter';

    initEventDrafter({ demo: import.meta.env.DEV && new URLSearchParams(location.search).has('demo') });
  </script>
</BaseLayout>
