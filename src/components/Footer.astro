---
import { socials, site, forms } from '../config';
---

<footer class="mt-16 border-t border-gray-100 bg-surface">
  <div class="mx-auto max-w-5xl px-4 py-8">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="font-heading text-lg font-bold text-brand-dark">{site.name}</p>
        <p class="mt-1 text-sm text-muted">{site.tagline}</p>
      </div>

      <div class="flex flex-wrap items-center gap-3 text-sm">
        <a href="/get-involved" class="font-medium text-brand hover:underline">
          Contact Us
        </a>
        {
          socials.email && (
            <a
              href={`mailto:${socials.email}`}
              class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-gray-200 text-muted transition hover:border-brand hover:text-brand"
              aria-label="Email"
              title="Email"
            >
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                <path d="M3 7l9 6 9-6"></path>
              </svg>
              <span class="sr-only">Email</span>
            </a>
          )
        }
        {
          socials.facebook && (
            <a
              href={socials.facebook}
              class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-gray-200 text-muted transition hover:border-brand hover:text-brand"
              rel="me noopener"
              target="_blank"
              aria-label="Facebook"
              title="Facebook"
            >
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
                <path d="M13.5 22v-8h2.7l.4-3h-3.1V9.1c0-.9.3-1.6 1.6-1.6h1.7V4.8c-.3 0-1.3-.1-2.5-.1-2.5 0-4.1 1.5-4.1 4.3V11H7.9v3h2.8v8h2.8z"></path>
              </svg>
              <span class="sr-only">Facebook</span>
            </a>
          )
        }
        {
          socials.instagram && (
            <a
              href={socials.instagram}
              class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-gray-200 text-muted transition hover:border-brand hover:text-brand"
              rel="me noopener"
              target="_blank"
              aria-label="Instagram"
              title="Instagram"
            >
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5" ry="5"></rect>
                <circle cx="12" cy="12" r="4"></circle>
                <circle cx="17" cy="7" r="1"></circle>
              </svg>
              <span class="sr-only">Instagram</span>
            </a>
          )
        }
      </div>
    </div>

    <p class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-muted">
      <span>© {new Date().getFullYear()} {site.name} All rights reserved.</span>
      <a href="/privacy" class="inline-flex min-h-11 items-center font-medium text-brand hover:underline sm:min-h-0">Privacy</a>
    </p>
  </div>
</footer>
