---
import BaseLayout from '../../layouts/BaseLayout.astro';

const ranges = [
  { days: 7, label: '7 days' },
  { days: 30, label: '30 days' },
  { days: 90, label: '90 days' },
  { days: 365, label: '12 months' },
];
---

<BaseLayout title="Site metrics" description="Private BCEC site metrics." noindex>
  <section class="mx-auto w-full max-w-5xl px-4 py-6 sm:py-10" aria-labelledby="metrics-heading">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div class="min-w-0">
        <p class="inline-flex rounded-full bg-brand-dark px-3 py-1 text-xs font-semibold uppercase tracking-wide text-white">
          Committee only
        </p>
        <h1 id="metrics-heading" class="mt-3 font-heading text-3xl font-bold text-brand-dark sm:text-4xl">Site metrics</h1>
        <p id="signed-in-as" class="mt-1 text-sm text-muted wrap-anywhere"></p>
      </div>
      <button id="sign-out" type="button" class="metrics-secondary sm:w-auto">Sign out</button>
    </div>

    <div class="mt-6 grid grid-cols-2 gap-2 sm:flex sm:flex-wrap" role="group" aria-label="Date range">
      {ranges.map((range) => (
        <button type="button" data-range={range.days} aria-pressed="false" class="range-button">
          {range.label}
        </button>
      ))}
    </div>

    <p id="metrics-status" class="mt-4 min-h-6 text-sm font-semibold leading-relaxed text-brand-dark" role="status" aria-live="polite">
      Loading…
    </p>

    <div id="metrics-content" class="space-y-8 sm:space-y-10" hidden>
      <p id="metrics-period" class="text-sm text-muted"></p>

      <dl id="metrics-stats" class="grid grid-cols-2 gap-3 sm:grid-cols-3"></dl>

      <section class="metrics-card" aria-labelledby="trend-heading">
        <h2 id="trend-heading" class="metrics-heading">Daily traffic</h2>
        <div id="metrics-chart" class="mt-4"></div>
        <details class="mt-4">
          <summary class="min-h-11 cursor-pointer py-2 text-sm font-semibold text-brand-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">
            Show daily breakdown
          </summary>
          <div id="metrics-daily" class="mt-2"></div>
        </details>
      </section>

      <section class="metrics-card" aria-labelledby="funnel-heading">
        <h2 id="funnel-heading" class="metrics-heading">Protect a tree email builder</h2>
        <dl id="metrics-assists" class="mt-3 grid gap-3 sm:grid-cols-2"></dl>
        <p class="mt-2 text-xs leading-relaxed text-muted">
          All-time assists are the public tally shown on the website, across every date range. The steps below
          only cover the selected period.
        </p>
        <p class="mt-4 text-sm text-muted">Each step is counted once per page visit. Opening a draft doesn’t confirm it was sent.</p>
        <ol id="metrics-funnel" class="mt-3"></ol>
      </section>

      <div class="grid gap-8 lg:grid-cols-2">
        <section class="metrics-card" aria-labelledby="pages-heading">
          <h2 id="pages-heading" class="metrics-heading">Top pages</h2>
          <div id="metrics-pages" class="mt-3"></div>
          <p class="mt-3 text-xs leading-relaxed text-muted">
            *Unique visitors are counted per day, so this column adds daily figures together. Someone who visits on
            three different days counts three times.
          </p>
        </section>

        <section class="metrics-card" aria-labelledby="sources-heading">
          <h2 id="sources-heading" class="metrics-heading">Traffic sources</h2>
          <p class="mt-1 text-sm text-muted">Where visits started. Moving between pages on this site isn’t counted here.</p>
          <div id="metrics-referrers" class="mt-3"></div>
        </section>

        <section class="metrics-card" aria-labelledby="links-heading">
          <h2 id="links-heading" class="metrics-heading">Key link clicks</h2>
          <div id="metrics-links" class="mt-3"></div>
        </section>

        <section class="metrics-card" aria-labelledby="campaigns-heading">
          <h2 id="campaigns-heading" class="metrics-heading">Campaign tags</h2>
          <p class="mt-1 text-sm text-muted">
            Add <code>?utm_source=newsletter</code> (or similar) to links you share to see them here.
          </p>
          <div id="metrics-campaigns" class="mt-3"></div>
        </section>
      </div>

      <section class="metrics-card" aria-labelledby="downloads-heading">
        <h2 id="downloads-heading" class="metrics-heading">Download for reports</h2>
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          <button id="download-daily" type="button" class="metrics-secondary">Download daily CSV</button>
          <button id="download-pages" type="button" class="metrics-secondary">Download pages CSV</button>
        </div>
      </section>

      <section class="text-sm leading-relaxed text-muted" aria-labelledby="notes-heading">
        <h2 id="notes-heading" class="font-heading text-base font-bold text-brand-dark">About these numbers</h2>
        <ul class="mt-2 list-disc space-y-1 pl-5">
          <li>Days follow Perth time. Today’s figures update as visits happen.</li>
          <li>Unique visitors are estimated per day from a temporary code for each device and network. Shared Wi‑Fi can merge people; changing networks can split one person.</li>
          <li>Visitors with ad blockers, JavaScript turned off, or “Do Not Track” / Global Privacy Control enabled aren’t counted. Known bots are excluded.</li>
          <li>Daily totals are kept for about 13 months. Visitor codes are deleted after each day.</li>
        </ul>
      </section>
    </div>
  </section>

  <style>
    @reference '../../styles/global.css';

    .metrics-card {
      @apply rounded-xl border border-brand-light bg-surface p-4 sm:p-6;
    }

    .metrics-heading {
      @apply font-heading text-xl font-bold text-brand-dark;
    }

    .metrics-secondary {
      @apply inline-flex min-h-11 w-full items-center justify-center rounded-lg border border-brand-light bg-white px-4 py-3 text-sm font-semibold text-brand-dark transition hover:border-brand hover:bg-brand-light/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand;
    }

    .range-button {
      @apply inline-flex min-h-11 items-center justify-center rounded-lg border border-brand-light bg-white px-4 py-2 text-sm font-semibold text-brand-dark transition hover:border-brand focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand aria-pressed:border-brand aria-pressed:bg-brand aria-pressed:text-white;
    }

    #metrics-content[hidden] {
      display: none;
    }
  </style>

  <script>
    import { getUser, logout, refreshSession } from '@netlify/identity';
    import {
      dailyCsv,
      downloadCsv,
      formatDate,
      pagesCsv,
      renderAssists,
      renderChart,
      renderDailyTable,
      renderFunnel,
      renderRankings,
      renderStats,
      type MetricsReport,
    } from '../../scripts/metrics-dashboard';

    const RANGES = [7, 30, 90, 365];
    const LOGIN_URL = '/admin/login/';

    const status = document.querySelector<HTMLElement>('#metrics-status')!;
    const content = document.querySelector<HTMLElement>('#metrics-content')!;
    const signedInAs = document.querySelector<HTMLElement>('#signed-in-as')!;
    const rangeButtons = document.querySelectorAll<HTMLButtonElement>('[data-range]');
    const byId = (id: string) => document.getElementById(id)!;

    const demoMode = import.meta.env.DEV && new URLSearchParams(location.search).has('demo');
    let currentReport: MetricsReport | null = null;
    let requestId = 0;

    const setStatus = (message: string, link?: { href: string; label: string }) => {
      status.replaceChildren(document.createTextNode(message));
      if (link) {
        const anchor = document.createElement('a');
        anchor.href = link.href;
        anchor.textContent = link.label;
        anchor.className = 'ml-1 underline underline-offset-2 hover:text-ink';
        status.append(anchor);
      }
    };

    const selectedDays = () => {
      const days = Number(new URLSearchParams(location.search).get('days'));
      return RANGES.includes(days) ? days : 30;
    };

    const markRange = (days: number) => {
      rangeButtons.forEach((button) => {
        button.setAttribute('aria-pressed', String(Number(button.dataset.range) === days));
      });
    };

    const render = (report: MetricsReport) => {
      currentReport = report;
      const updated = new Date(report.generatedAt).toLocaleString('en-AU', {
        timeZone: report.timeZone,
        dateStyle: 'medium',
        timeStyle: 'short',
      });
      byId('metrics-period').textContent = `${formatDate(report.from)} – ${formatDate(report.to)} (Perth time). Updated ${updated}.`;
      renderStats(byId('metrics-stats'), report);
      renderChart(byId('metrics-chart'), report.daily);
      renderDailyTable(byId('metrics-daily'), report.daily);
      renderFunnel(byId('metrics-funnel'), report);
      renderAssists(byId('metrics-assists'), report);
      renderRankings(report, {
        pages: byId('metrics-pages'),
        referrers: byId('metrics-referrers'),
        campaigns: byId('metrics-campaigns'),
        links: byId('metrics-links'),
      });
      content.hidden = false;
      setStatus('');
      try {
        sessionStorage.removeItem('bcec-admin-auto-redirect');
      } catch {
        // Best-effort; see the redirect guard on the sign-in page.
      }
    };

    const fetchReport = async (days: number, current: number, retry = true): Promise<void> => {
      const response = await fetch(`/api/admin/site-metrics?days=${days}`, {
        credentials: 'same-origin',
        headers: { Accept: 'application/json' },
        cache: 'no-store',
      });
      if (current !== requestId) return;
      if (response.status === 401 && retry) {
        await refreshSession().catch(() => null);
        return fetchReport(days, current, false);
      }
      if (response.status === 401) {
        content.hidden = true;
        setStatus('Your session has ended.', { href: LOGIN_URL, label: 'Sign in again' });
        return;
      }
      if (response.status === 403) {
        content.hidden = true;
        setStatus('This account doesn’t have access to site metrics.', { href: LOGIN_URL, label: 'Switch account' });
        return;
      }
      if (!response.ok) throw new Error(`Report request failed (${response.status})`);
      const report = (await response.json()) as MetricsReport;
      if (current === requestId) render(report);
    };

    const load = async (days: number) => {
      const current = ++requestId;
      markRange(days);
      setStatus('Loading…');
      try {
        if (demoMode) {
          const { demoReport } = await import('../../scripts/metrics-demo');
          if (current === requestId) render(demoReport(days));
          return;
        }
        await fetchReport(days, current);
      } catch {
        if (current === requestId) setStatus('Metrics couldn’t be loaded. Check your connection and try again.');
      }
    };

    rangeButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const days = Number(button.dataset.range);
        const url = new URL(location.href);
        url.searchParams.set('days', String(days));
        history.replaceState(null, '', url);
        void load(days);
      });
    });

    byId('download-daily').addEventListener('click', () => {
      if (currentReport) downloadCsv(`bcec-site-metrics-daily-${currentReport.from}-to-${currentReport.to}.csv`, dailyCsv(currentReport));
    });
    byId('download-pages').addEventListener('click', () => {
      if (currentReport) downloadCsv(`bcec-site-metrics-pages-${currentReport.from}-to-${currentReport.to}.csv`, pagesCsv(currentReport));
    });

    byId('sign-out').addEventListener('click', async () => {
      try {
        await logout();
      } finally {
        location.replace(LOGIN_URL);
      }
    });

    const init = async () => {
      if (demoMode) {
        signedInAs.textContent = 'Demo data (local preview only)';
        await load(selectedDays());
        return;
      }
      try {
        await refreshSession().catch(() => null);
        const user = await getUser();
        if (!user) {
          setStatus('Please sign in to view site metrics.', { href: LOGIN_URL, label: 'Sign in' });
          return;
        }
        signedInAs.textContent = `Signed in as ${user.email ?? 'committee member'}`;
      } catch {
        setStatus('Sign-in isn’t available here.', { href: LOGIN_URL, label: 'Go to sign in' });
        return;
      }
      await load(selectedDays());
    };

    void init();
  </script>
</BaseLayout>
